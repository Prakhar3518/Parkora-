# Server
PORT=8080
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (MySQL 8)
DB_DIALECT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=parkora_db
DB_USER=root
DB_PASSWORD=change_me
# "none" = create missing tables only, "alter" = auto-alter tables (dev only)
DB_SYNC=none

# Auth - CHANGE THIS to a long random string before deploying
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Admin account seeded on first start
ADMIN_NAME=Parkora Admin
ADMIN_EMAIL=admin@parkora.com
ADMIN_PASSWORD=Admin@12345

# Payments (stub by default; set to razorpay when integrating - see docs/RAZORPAY.md)
PAYMENT_MODE=stub
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
